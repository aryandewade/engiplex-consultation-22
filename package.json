{
  "name": "engiplex-consultation-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade consultancy and mentor booking platform for ENGIPLEX",
  "scripts": {
    "build": "cd server && npm install",
    "start": "cd server && npm start",
    "dev": "npm run client",
    "dev:all": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && bun run dev",
    "client": "cd client && bun run dev",
    "seed": "bun server/src/scripts/seed.ts",
    "test": "cd server && bun test"
  }
}
